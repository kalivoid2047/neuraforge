[Unit]
Description=Neuraforge API (FastAPI, Gunicorn + UvicornWorker)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=nf-api
Group=nf-api
WorkingDirectory=/opt/neuraforge/current/apps/api
EnvironmentFile=/etc/neuraforge/api.env
LoadCredential=jwt-ed25519.pem:/etc/neuraforge/jwt-ed25519.pem
Environment=NF_JWT_KEY_FILE=%d/jwt-ed25519.pem

ExecStart=/opt/neuraforge/current/apps/api/.venv/bin/gunicorn neuraforge.main:app \
    --chdir src \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8001 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -HUP $MAINPID
ExecStartPost=/bin/sh -c 'for i in $(seq 1 10); do curl -sf http://127.0.0.1:8001/api/v1/health && exit 0; sleep 1; done; exit 1'

Restart=on-failure
RestartSec=2

# Hardening (SRS §9) — least-privilege sandbox, same discipline as the
# container-free exercise runner (assessment/runner.py) applies to itself.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute intentionally omitted: numpy/BLAS (used by both the
# app and learner exercise code executed in-process via assessment/runner.py)
# can hit W^X-incompatible codepaths under it.
SystemCallFilter=@system-service
CapabilityBoundingSet=

MemoryMax=1G
TasksMax=256

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neuraforge-api

[Install]
WantedBy=multi-user.target
