{
  "name": "neuraforge",
  "private": true,
  "version": "0.1.0",
  "description": "Neuraforge — Building Large Language Models From Scratch. A 12-month interactive AI engineering program.",
  "workspaces": [
    "apps/*",
    "packages/*"
