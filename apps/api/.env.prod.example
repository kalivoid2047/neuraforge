# Neuraforge API — production environment (SRS §10.1: .env files, validated
# by core/config.py at boot). Copy to /etc/neuraforge/api.env on the server,
# chmod 600, owned by the nf-api service user. Never commit the real file.
#
# No inline (trailing) comments on value lines below: systemd's
# EnvironmentFile= parser takes the rest of the line as the value verbatim,
# same as scripts/deploy.sh's env-file reader — either would otherwise treat
# "false  # some comment" as the literal value instead of just `false`.

NF_ENV=production
NF_DATABASE_URL=postgresql+asyncpg://neuraforge:REPLACE_WITH_REAL_PASSWORD@localhost:5432/neuraforge
NF_CORS_ORIGINS=["https://your-domain.example"]

# Never seed demo data in production.
NF_AUTO_SEED=false

# Enforced by config validation outside dev; set explicitly anyway.
NF_DEV_AUTOLOGIN=false

# JWT signing key: provisioned by scripts/provision.sh and delivered to the
# service via systemd LoadCredential (deploy/systemd/neuraforge-api.service),
# not via this file — NF_JWT_KEY_FILE is set by the unit's Environment= line
# to the systemd credentials path (%d/jwt-ed25519.pem), not set here.

# Ember AI tutor: disabled by default in this deployment — no local Ollama
# endpoint is running on the server. Point at a real OpenAI-compatible
# endpoint and flip to true when one is available (FR-TUTOR-4).
NF_EMBER_ENABLED=false
# NF_EMBER_BASE_URL=https://your-inference-endpoint.example/v1
# NF_EMBER_API_KEY=REPLACE_WITH_REAL_KEY
