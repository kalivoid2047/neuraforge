# Neuraforge API configuration (validated by core/config.py at boot)
NF_ENV=dev                                            # dev | staging | production
NF_DATABASE_URL=sqlite+aiosqlite:///./neuraforge-dev.db
# production: NF_DATABASE_URL=postgresql+asyncpg://nf_api:***@localhost:5432/neuraforge
NF_CORS_ORIGINS=["http://localhost:3000"]
NF_AUTO_SEED=true                                     # dev only: seed demo data on first boot
