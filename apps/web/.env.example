# Neuraforge web — build-time env (Next.js inlines NEXT_PUBLIC_* at `next build`,
# so this must be present before building, not just at runtime).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production: same-origin through Nginx, so the browser calls a relative-ish
# HTTPS origin instead of a hardcoded dev port (deploy/nginx/neuraforge.conf
# proxies /api and /ws to the API service):
# NEXT_PUBLIC_API_URL=https://your-domain.example
